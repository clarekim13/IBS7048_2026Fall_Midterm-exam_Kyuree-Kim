# BiocManager::install(c("DECIPHER", "phangorn"))
a

library(DECIPHER)
library(phangorn)

# ---- 1) Select the five most abundant ASVs ----
abund <- colSums(seqtab.nochim)                      # total read count of each ASV across both samples
top5  <- order(abund, decreasing = TRUE)[1:5]        # column indices of the top 5 ASVs
seqs  <- getSequences(seqtab.nochim)[top5]           # their DNA sequences (dada2 function)
names(seqs) <- paste0("ASV", 1:5)                    # name them ASV1-ASV5 in decreasing order of abundance

# Show the read count of each selected ASV
data.frame(ASV = paste0("ASV", 1:5), reads = unname(abund[top5]))

# ---- 2) Multiple sequence alignment with DECIPHER ----
alignment <- AlignSeqs(DNAStringSet(seqs), anchor = NA)

# ---- 3) Neighbor-joining tree with phangorn ----
phang.align <- phyDat(as(alignment, "matrix"), type = "DNA")  # convert the alignment to phangorn format
dm     <- dist.ml(phang.align)                       # pairwise maximum-likelihood distances between ASVs
treeNJ <- NJ(dm)                                     # build an (unrooted) neighbor-joining tree from the distances

# ---- 4) Plot the tree ----
plot(treeNJ, main = "Neighbor-joining tree of the top 5 ASVs")

# ---- 5) Save the tree as a Newick file and check its content ----
write.tree(treeNJ, file = "top5_ASV_NJ.nwk")
readLines("top5_ASV_NJ.nwk")


