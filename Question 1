IBS7054_22262021@bagel-S2600CO:~/IBS7048_2026$ cat > sort_bash.sh << 'EOF'

#!/bin/bash
# Copy FASTQ files from raw/ into sorted_bash/<Condition>/<Read>/
# Original files are kept in raw/ for Problem 2

rm -rf sorted_bash                                   # remove old results so the script can be re-run clearly
for f in raw/*.fastq                                 # loop over every FASTQ file in raw/
do
  name=$(basename "$f")                              # keep only the file name (drop "raw/")
  condition=$(echo "$name" | cut -d_ -f2)            # split by "_": Control / Treated
  read=$(echo "$name" | cut -d_ -f4 | cut -d. -f1)   # without ".fastq": R1 / R2
  mkdir -p "sorted_bash/$condition/$read"            # create the target folder
  cp "$f" "sorted_bash/$condition/$read/"            # copy with the same filename (original stays in raw/)
done

# report the number of files in each folder
echo "== Number of files per folder =="
for d in sorted_bash/*/*
do
  echo "$d : $(ls "$d" | wc -l)"
done
echo "raw : $(ls raw | wc -l) (orignals kept)"
EOF

