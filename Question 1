IBS7054_22262021@bagel-S2600CO:~/IBS7048_2026$ cat > sort_bash.sh << 'EOF'
#!/bin/bash
# raw -> sorted_bash/<Condition>/<Read>/ 로 복사 (원본 유지)
rm -rf sorted_bash
for f in raw/*.fastq
do
  name=$(basename "$f")                              # 파일명만 추출
  condition=$(echo "$name" | cut -d_ -f2)            # Control / Treated
  read=$(echo "$name" | cut -d_ -f4 | cut -d. -f1)   # R1 / R2
  mkdir -p "sorted_bash/$condition/$read"            # 폴더 생성
  cp "$f" "sorted_bash/$condition/$read/"            # 복사 (원본 유지)
done

echo "== 폴더별 파일 수 =="
for d in sorted_bash/*/*
do
  echo "$d : $(ls "$d" | wc -l)"
done
echo "raw : $(ls raw | wc -l) (원본 유지)"
EOF

