library(dada2)

rawpath <- system.file("extdata", package = "dada2")
fnFs <- file.path(rawpath, c("sam1F.fastq.gz", "sam2F.fastq.gz"))
fnRs <- file.path(rawpath, c("sam1R.fastq.gz", "sam2R.fastq.gz"))
sample.names <- c("sam1", "sam2")

# Step 1) Plot quality profiles: base quality at each position of the forward and reverse reads
plotQualityProfile(fnFs)
plotQualityProfile(fnRs)

# Step 2) Filter and trim reads
#   truncLen = c(230,160): cut forward reads at 230 bp and reverse reads at 160 bp
#                          (reads shorter than this are discarded)
#   maxEE = c(2,2)       : discard reads with more than 2 expected errors
#   truncQ = 2           : cut a read at the first base with quality <= 2
#   maxN = 0             : discard reads containing any N
#   rm.phix = TRUE       : remove PhiX control reads
filtFs <- file.path(tempdir(), "filtered", paste0(sample.names, "_F_filt.fastq.gz"))
filtRs <- file.path(tempdir(), "filtered", paste0(sample.names, "_R_filt.fastq.gz"))
names(filtFs) <- sample.names
names(filtRs) <- sample.names
out <- filterAndTrim(fnFs, filtFs, fnRs, filtRs,
                     truncLen = c(230, 160), maxEE = c(2, 2),
                     truncQ = 2, maxN = 0, rm.phix = TRUE,
                     compress = TRUE, multithread = FALSE)

# Step 3) Learn the sequencing error rates from the data (one model for F, one for R)
errF <- learnErrors(filtFs, multithread = FALSE)
errR <- learnErrors(filtRs, multithread = FALSE)

# Step 4) Denoise: use the error model to separate true sequences from sequencing errors
dadaFs <- dada(filtFs, err = errF, multithread = FALSE)
dadaRs <- dada(filtRs, err = errR, multithread = FALSE)

# Step 5) Merge forward and reverse reads where they overlap, then build the ASV table
mergers <- mergePairs(dadaFs, filtFs, dadaRs, filtRs, verbose = TRUE)
seqtab  <- makeSequenceTable(mergers)          # rows = samples, columns = ASVs

# Step 6) Remove chimeras (artificial sequences made of two parent sequences)
seqtab.nochim <- removeBimeraDenovo(seqtab, method = "consensus",
                                    multithread = FALSE, verbose = TRUE)

# Step 7) Read-tracking table: reads remaining after each step
getN <- function(x) sum(getUniques(x))
track <- cbind(out, sapply(dadaFs, getN), sapply(dadaRs, getN),
               sapply(mergers, getN), rowSums(seqtab.nochim))
colnames(track) <- c("input", "filtered", "denoisedF", "denoisedR", "merged", "nonchim")
rownames(track) <- sample.names
track
round(100 * track / track[, "input"], 1)       # percent of input reads remaining

# Step 8) Chimeras removed
ncol(seqtab)                                   # ASVs before chimera removal
ncol(seqtab) - ncol(seqtab.nochim)             # ASVs removed as chimeras
sum(seqtab) - sum(seqtab.nochim)               # reads removed as chimeras
dim(seqtab.nochim)                             # samples x final ASVs


