IBS7054_22262021@bagel-S2600CO:~/IBS7048_2026$ cat > sort_R.R << 'EOF'
# Copy files from raw into sorted_R/<Condition>/<Read>/ using R functions
if (dir.exists("sorted_R")) unlink("sorted_R", recursive = TRUE)
files <- list.files("raw", pattern = "\\.fastq$")
parts <- strsplit(sub("\\.fastq$", "", files), "_")
condition <- sapply(parts, `[`, 2)
read      <- sapply(parts, `[`, 4)
for (i in seq_along(files)) {
  dest <- file.path("sorted_R", condition[i], read[i])
  dir.create(dest, recursive = TRUE, showWarnings = FALSE)
  file.copy(file.path("raw", files[i]), file.path(dest, files[i]))
}
cat("== Number of files per folder ==\n")
for (d in sort(list.dirs("sorted_R", recursive = TRUE))) {
  n <- length(list.files(d, pattern = "\\.fastq$"))
  if (n > 0) cat(d, ":", n, "\n")
}
cat("raw :", length(list.files("raw")), "(originals kept)\n")
EOF
