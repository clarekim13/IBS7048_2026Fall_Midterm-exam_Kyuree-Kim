# TRUE if both methods produced exactly the same folders and filenames
cat("Same file paths and names?", identical(a, b), "\n")

# Compare the number of files in each <Condition>/<Read> folder
print(rbind(bash = table(dirname(a)), R = table(dirname(b))))
EOF
